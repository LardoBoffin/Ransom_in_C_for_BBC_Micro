void vdu25(int t,int x,int y)
{
   _kernel_oswrch(25);_kernel_oswrch(t);
   _kernel_oswrch(x%256);_kernel_oswrch(x/256);
   _kernel_oswrch(y%256);_kernel_oswrch(y/256);
}  

int pos(int xy)
{
 int retVal;
 retVal=_kernel_osbyte(134,0,0);
 /* 8*0 = LSB, 8*1 =MSB */
 return (retVal >> (8*xy)) & 0xff;
}

int inkey(int lsb,int msb)
{  
   int result;
   _kernel_osbyte(15,1,0);result=_kernel_osbyte(129,lsb,msb);
   msb = (result >> (8*1)) & 0xFF;
   if (msb==0)
   {
    lsb = (result >> (8*0)) & 0xFF;return(lsb);
   }else
   {return(0);}
}

